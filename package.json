{
  "name": "auto-vrm-converter",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop pipeline that inspects Unity character packages and converts humanoid models to VRM 1.0 and animations to VRMA through UniVRM.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/bootstrap.cjs",
    "start": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev": "npm start",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "wait-on": "^8.0.4"
  }
}
